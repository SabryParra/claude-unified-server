# CUS — environment variables
# Copy to .env and fill in values for production.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────
# Strong random secret for JWT signing. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# ── Optional ──────────────────────────────────────────────────
# HTTP server bind address and port (default: 0.0.0.0:3017)
# HOST=0.0.0.0
# PORT=3017

# Storage root directory (default: ./data)
# CUS_DATA_DIR=/var/lib/cus/data
